# ===== Dropbox（写真の一覧取得・サムネイル取得・共有リンク作成） =====
# Dropbox App Console（https://www.dropbox.com/developers/apps）の「FORT-photo-ledger」で発行
# 権限: files.metadata.read / files.content.read / sharing.write（共有リンクを作る場合のみ）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# OAuth（token_access_type=offline）で取得したリフレッシュトークン。手順は HANDOFF.md 参照
DROPBOX_REFRESH_TOKEN=

# ===== Metricool（Instagram 予約投稿） =====
# Metricool の「アカウント設定 > API」で発行するトークン（API はプランによって利用可否あり・要確認）
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=6473008
METRICOOL_BLOG_ID=8220265
METRICOOL_TIMEZONE=Asia/Tokyo

# ===== 投稿の既定値 =====
INSTAGRAM_ACCOUNT=fort_family.jp
POST_TIME=20:00
