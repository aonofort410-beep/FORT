# ============================================================
# FORT 社内ポータル ｜ 環境変数サンプル
#   このファイルを .env.local にコピーして値を設定してください。
#   .env.local は git にコミットされません（.gitignore 済み）。
#   取得手順は docs/07_setup.md を参照。
# ============================================================

# Supabase プロジェクトの URL（例：https://xxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon key（公開しても良い公開鍵）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase の service_role key（サーバー側だけで使う。絶対に公開しない）
# ※ Phase 0 のアプリ本体では未使用。管理スクリプト等で使う場合に設定。
SUPABASE_SERVICE_ROLE_KEY=
